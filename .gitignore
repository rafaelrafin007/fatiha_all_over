# FatihaAllOver monorepo: Laravel, two Next.js apps, and future mobile clients.
# Commit source, migrations, documentation, dependency manifests and lockfiles.

# Environment files at any depth. Templates must contain placeholders only.
.env*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.envrc

# Credentials, private keys, signing material and local secret configuration.
auth.json
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
id_rsa
id_dsa
id_ecdsa
id_ed25519
service-account*.json
serviceAccount*.json
credentials.json
secrets.json

# Laravel backend: dependencies, runtime state, caches and generated assets.
/backend/vendor/
/backend/bootstrap/cache/**
!/backend/bootstrap/cache/**/
!/backend/bootstrap/cache/**/.gitignore
!/backend/bootstrap/cache/**/.gitkeep
/backend/storage/**
!/backend/storage/**/
!/backend/storage/**/.gitignore
!/backend/storage/**/.gitkeep
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/public/fonts-manifest.dev.json
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/.php-cs-fixer.cache
/backend/.phpactor.json
/backend/.phpstan/
/backend/.phpstan.cache
/backend/.pest/
/backend/_ide_helper.php
/backend/_ide_helper_models.php
/backend/.phpstorm.meta.php
/backend/Homestead.json
/backend/Homestead.yaml
/backend/.vagrant/
/backend/database/*.sqlite
/backend/database/*.sqlite-*
/backend/database/*.sqlite3
/backend/database/*.sqlite3-*
/backend/backups/

# JavaScript dependencies, tool caches and deployment-local state.
node_modules/
.next/
.vercel/
.turbo/
.parcel-cache/
.cache/
.npm/
.pnpm-store/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts
.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/sdks/
!**/.yarn/versions/

# Generated frontend/root outputs; keep similarly named source folders elsewhere.
/build/
/dist/
/fatihaallover-web/build/
/fatihaallover-web/dist/
/fatihaallover-web/out/
/admin-panel/build/
/admin-panel/dist/
/admin-panel/out/

# Test reports and local execution artifacts.
coverage/
.nyc_output/
playwright-report/
test-results/
/backend/tests/.phpunit.cache/

